{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hastane-yorum-atlasi",
  "main": "./worker.js",
  "account_id": "9850a4282ca9127be7ed809ea1343750",
  "compatibility_date": "2026-09-04",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/private-reviews/*"
    ],
    "not_found_handling": "404-page"
  }
}
